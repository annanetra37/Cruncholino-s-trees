// Cruncholino trees — data model.
//
// PostGIS notes (T2.2): Prisma has no native geography type. `Tree.geom` is
// declared as `Unsupported(...)` so Prisma knows the column exists and does not
// report schema drift, but Prisma never reads or writes it. The column is a
// Postgres GENERATED column derived from latitude/longitude (see the initial
// migration), so it can never disagree with the plain coordinates. All spatial
// predicates (ST_DWithin, bbox) are written with `prisma.$queryRaw` in
// src/lib/trees/query.ts.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis, pg_trgm(map: "pg_trgm")]
}

// ---------------------------------------------------------------------------
// Enums. Every one of them carries UNKNOWN: field data is incomplete data.
// ---------------------------------------------------------------------------

enum SpeciesCategory {
  FRUIT
  NUT
  BERRY
  ORNAMENTAL
  OTHER
}

enum AgeBand {
  YOUNG
  MID
  OLD
  UNKNOWN
}

enum Condition {
  GOOD
  FAIR
  POOR
  DEAD
  UNKNOWN
}

enum FruitQuality {
  GOOD
  FAIR
  POOR
  NONE
  UNKNOWN
}

/// How hard the fruit is to actually pick. Separate from `FruitQuality`,
/// which says whether the fruit is worth picking: a tree can carry a fine crop
/// ten metres up, and for someone planning a route that is the difference
/// between a stop and a detour.
enum Reachability {
  GROUND
  LADDER
  OUT_OF_REACH
  UNKNOWN
}

enum GeocodeStatus {
  OK
  FAILED
  MANUAL
  PENDING
}

enum TreeStatus {
  DRAFT
  PUBLISHED
  FLAGGED
  ARCHIVED
}

enum LocationSource {
  GPS
  EXIF
  MANUAL
  IMPORT
}

enum Role {
  CONTRIBUTOR
  REVIEWER
  ADMIN
}

// ---------------------------------------------------------------------------
// Domain
// ---------------------------------------------------------------------------

/// Lookup table, deliberately not an enum: adding "quince" must not require a
/// migration and a deploy.
model Species {
  id        String          @id @default(uuid()) @db.Uuid
  slug      String          @unique
  nameEn    String          @map("name_en")
  nameHy    String?         @map("name_hy")
  category  SpeciesCategory @default(OTHER)
  isActive  Boolean         @default(true) @map("is_active")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  trees Tree[]

  @@index([isActive, category])
  @@map("species")
}

model Tree {
  id String @id @default(uuid()) @db.Uuid

  speciesId String  @map("species_id") @db.Uuid
  species   Species @relation(fields: [speciesId], references: [id], onDelete: Restrict)

  /// Plain coordinates are the source of truth and are always stored: CSV
  /// export, debugging and ordinary Prisma reads are all simpler for it.
  latitude  Float @db.DoublePrecision
  longitude Float @db.DoublePrecision

  /// GENERATED ALWAYS from longitude/latitude — see the initial migration.
  geom Unsupported("geography(Point, 4326)")?

  locationSource LocationSource @default(MANUAL) @map("location_source")
  accuracyM      Float?         @map("accuracy_m")

  ageBand          AgeBand      @default(UNKNOWN) @map("age_band")
  ageYearsEstimate Int?         @map("age_years_estimate")
  condition        Condition    @default(UNKNOWN)
  fruitQuality     FruitQuality @default(UNKNOWN) @map("fruit_quality")
  reachability     Reachability @default(UNKNOWN)
  notes            String?

  // Resolved location, denormalised so the dashboard can filter on it without
  // a join or a spatial lookup.
  addressLine   String?       @map("address_line")
  city          String?
  district      String?
  region        String?
  country       String?
  countryCode   String?       @map("country_code")
  postalCode    String?       @map("postal_code")
  geocodeRaw    Json?         @map("geocode_raw")
  geocodeStatus GeocodeStatus @default(PENDING) @map("geocode_status")

  status TreeStatus @default(PUBLISHED)

  /// Idempotency key supplied by the offline queue (T4.5): re-syncing an
  /// entry whose response was lost must not create a second tree.
  clientRef String? @unique @map("client_ref")

  createdById String? @map("created_by_id") @db.Uuid
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  photos    TreePhoto[]
  revisions TreeRevision[]

  @@index([speciesId])
  @@index([condition])
  @@index([ageBand])
  @@index([fruitQuality])
  @@index([reachability])
  @@index([city])
  @@index([region])
  @@index([status])
  @@index([createdAt])
  @@index([createdById])
  @@index([geocodeStatus])
  /// Matches the dashboard's most common filter combination.
  @@index([status, deletedAt, speciesId, condition])
  @@map("trees")
}

model TreePhoto {
  id         String    @id @default(uuid()) @db.Uuid
  treeId     String    @map("tree_id") @db.Uuid
  tree       Tree      @relation(fields: [treeId], references: [id], onDelete: Cascade)
  storageKey String    @unique @map("storage_key")
  width      Int?
  height     Int?
  bytes      Int?
  takenAt    DateTime? @map("taken_at")
  sortOrder  Int       @default(0) @map("sort_order")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([treeId, sortOrder])
  @@map("tree_photos")
}

/// Audit trail. Every write to a tree appends one row; nothing is ever updated.
model TreeRevision {
  id        String   @id @default(uuid()) @db.Uuid
  treeId    String   @map("tree_id") @db.Uuid
  tree      Tree     @relation(fields: [treeId], references: [id], onDelete: Cascade)
  userId    String?  @map("user_id") @db.Uuid
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  diff      Json
  changedAt DateTime @default(now()) @map("changed_at")

  @@index([treeId, changedAt])
  @@map("tree_revisions")
}

/// Reverse-geocode results keyed by coordinate rounded to 4dp (~11 m), so a
/// street full of trees costs one provider call, not forty.
model GeocodeCache {
  key         String   @id
  latitude    Float    @db.DoublePrecision
  longitude   Float    @db.DoublePrecision
  provider    String
  payload     Json
  addressLine String?  @map("address_line")
  city        String?
  district    String?
  region      String?
  country     String?
  countryCode String?  @map("country_code")
  postalCode  String?  @map("postal_code")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("geocode_cache")
}

// ---------------------------------------------------------------------------
// Auth.js models (email magic link — no passwords)
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique
  name          String?
  emailVerified DateTime? @map("email_verified")
  image         String?
  role          Role      @default(CONTRIBUTOR)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  accounts  Account[]
  sessions  Session[]
  trees     Tree[]
  revisions TreeRevision[]

  @@map("users")
}

model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}
