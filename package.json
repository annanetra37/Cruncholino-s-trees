{
  "name": "cruncholino-trees",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "dev": "next dev -p ${PORT:-3000}",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "job:geocode-backfill": "tsx scripts/geocode-backfill.ts",
    "job:orphan-cleanup": "tsx scripts/orphan-cleanup.ts",
    "import:csv": "tsx scripts/import-csv.ts",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.3",
    "@aws-sdk/client-s3": "3.999.0",
    "@aws-sdk/s3-request-presigner": "3.999.0",
    "@prisma/client": "6.19.3",
    "maplibre-gl": "6.9.0",
    "next": "15.5.25",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "10.0.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@playwright/test": "1.56.0",
    "@tailwindcss/postcss": "4.1.14",
    "@types/node": "22.18.6",
    "@types/nodemailer": "8.0.1",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "eslint": "9.37.0",
    "eslint-config-next": "15.5.25",
    "husky": "9.1.7",
    "lint-staged": "16.2.3",
    "prettier": "3.6.2",
    "prisma": "6.19.3",
    "tailwindcss": "4.1.14",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "@auth/core": ">=0.41.3",
      "postcss": ">=8.5.28",
      "sharp": ">=0.35.4",
      "deepmerge-ts": ">=8.0.2"
    }
  }
}
