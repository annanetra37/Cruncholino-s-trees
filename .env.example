# ---------------------------------------------------------------------------
# Copy to .env.local for development. Every variable is validated at boot by
# src/env.ts — a missing one stops the process with its name, not a stray
# `undefined` three screens later.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000

# --- Database --------------------------------------------------------------
# Local: matches docker-compose.yml.
# Railway: set as a reference variable, never a literal — ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://trees:trees@localhost:5432/trees

# --- Auth ------------------------------------------------------------------
# openssl rand -base64 32
AUTH_SECRET=replace-me-with-32-random-bytes
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
EMAIL_FROM=trees@example.org
# smtp://user:password@smtp.example.org:587 — leave unset in development and
# use AUTH_DEV_LOGIN instead.
# EMAIL_SERVER=
# Development only; refused outright when NODE_ENV=production.
AUTH_DEV_LOGIN=true

# --- Password account (optional, works in production) ----------------------
# One email and password that can sign in without any mail server. Use it to
# get into a deployment before SMTP is set up, and as a way back in if the mail
# provider goes down.
#
# Both must be set or neither. The password can be as simple as you like — the
# only rule is that it is not empty. What protects a short password is the rate
# limit on sign-in attempts (ten per address per minute, all logged), not its
# length.
#
# This is ONE SHARED LOGIN, not general password auth. Give contributors their
# own accounts through the magic link: a shared account makes every tree look
# like it was recorded by the same person.
# OPERATOR_EMAIL=you@example.org
# OPERATOR_PASSWORD=trees2026
# CONTRIBUTOR | REVIEWER | ADMIN
OPERATOR_ROLE=ADMIN

# --- Geocoding -------------------------------------------------------------
# nominatim | maptiler | none
# Nominatim's usage policy forbids heavy production use: budget for a paid key
# before launch and switch GEOCODING_PROVIDER to maptiler.
GEOCODING_PROVIDER=nominatim
# GEOCODING_API_KEY=
# GEOCODING_BASE_URL=
GEOCODING_USER_AGENT=cruncholino-trees/0.1 (+https://example.org)
GEOCODING_TIMEOUT_MS=3000
# Nominatim's policy is one request per second. Set to 0 for a paid provider.
GEOCODING_MIN_INTERVAL_MS=1100

# --- Map -------------------------------------------------------------------
# The MapLibre demo style needs no key and is fine for development. For
# production point this at MapTiler or Protomaps and set a monthly budget.
NEXT_PUBLIC_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
# NEXT_PUBLIC_MAP_TILES_KEY=
NEXT_PUBLIC_MAP_DEFAULT_CENTER=44.5152,40.1872
NEXT_PUBLIC_MAP_DEFAULT_ZOOM=11

# --- Photo storage (Cloudflare R2) -----------------------------------------
# Optional: without these the app runs and photo upload reports itself as
# unavailable, rather than failing at the moment a contributor tries to use it.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=trees-photos
# R2_PUBLIC_URL=https://photos.example.org

# --- Behaviour -------------------------------------------------------------
# DECIDED: the dashboard is login-gated. Setting this to true publishes the
# coordinates of every tree — including trees in private gardens — to anyone
# with the URL.
PUBLIC_READ=false
# Only meaningful when PUBLIC_READ=true: rounds coordinates to ~110 m for
# signed-out viewers.
FUZZ_PUBLIC_COORDINATES=false
# DECIDED: submissions publish immediately. Turning this on would land them in
# DRAFT to wait for a reviewer, which loses contributions if nobody works the
# queue.
MODERATION_ENABLED=false
DUPLICATE_RADIUS_M=5
MAX_GEOJSON_FEATURES=5000
MAX_PAGE_SIZE=200
RATE_LIMIT_WRITES_PER_MINUTE=30
LOG_LEVEL=info
